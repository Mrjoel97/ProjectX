{
  "$schema": "https://biomejs.dev/schemas/2.5.3/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/_generated",
      "!**/.next",
      "!**/dist",
      "!.planning",
      "!.tmp",
      "!.worktrees",
      "!docs/design/mockups",
      "!graphify-out",
      "!packages/core/src/designKnowledge.generated.ts",
      "!packages/core/src/__fixtures__/assembly/empty.json",
      "!packages/core/src/__fixtures__/assembly/malformed.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "./_generated/server": {
                "importNames": ["query", "mutation", "action"],
                "message": "Raw query/mutation/action are banned. Import tenantQuery/tenantMutation/tenantAction from convex/lib/functions.ts (or use internalQuery/internalMutation/internalAction for allow-listed internal modules)."
              },
              "../_generated/server": {
                "importNames": ["query", "mutation", "action"],
                "message": "Raw query/mutation/action are banned. Import tenantQuery/tenantMutation/tenantAction from convex/lib/functions.ts (or use internalQuery/internalMutation/internalAction for allow-listed internal modules)."
              }
            }
          }
        }
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "overrides": [
    {
      "includes": [
        "packages/backend/convex/lib/functions.ts",
        "packages/backend/convex/invites.ts",
        "packages/backend/convex/webHttp.ts",
        "packages/backend/convex/webAssets.ts",
        "packages/backend/convex/webProjects.ts",
        "packages/backend/convex/webRuntime.ts",
        "packages/backend/convex/webForms.ts",
        "packages/backend/convex/onlinePresence.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    }
  ]
}
