{
  "$schema": "https://biomejs.dev/schemas/2.0.0/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": ["**", "!**/_generated/**", "!**/.next/**", "!**/dist/**"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "./_generated/server": {
                "importNames": ["query", "mutation", "action"],
                "message": "Raw query/mutation/action are banned. Import tenantQuery/tenantMutation/tenantAction from convex/lib/functions.ts (or use internalQuery/internalMutation/internalAction for allow-listed internal modules)."
              },
              "../_generated/server": {
                "importNames": ["query", "mutation", "action"],
                "message": "Raw query/mutation/action are banned. Import tenantQuery/tenantMutation/tenantAction from convex/lib/functions.ts (or use internalQuery/internalMutation/internalAction for allow-listed internal modules)."
              }
            }
          }
        }
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "overrides": [
    {
      "includes": ["packages/backend/convex/lib/functions.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    }
  ]
}
