{
  "name": "pikar-ai",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "test": "turbo run test",
    "gate": "pnpm typecheck --force && pnpm test --force --concurrency=1 && pnpm build --force",
    "gate:lint": "biome ci . --diagnostic-level=error --max-diagnostics=none",
    "test:e2e": "pnpm --filter @pikar/web test:e2e",
    "eval:golden": "pnpm --filter @pikar/backend eval:golden",
    "boot:check": "node scripts/boot-check.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "turbo": "2.10.4",
    "typescript": "^7.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
