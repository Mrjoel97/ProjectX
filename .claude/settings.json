{
  "enabledPlugins": {
    "ponytail@ponytail": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "C:\\Users\\expert\\.local\\bin\\graphify.EXE hook-guard search"
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "C:\\Users\\expert\\.local\\bin\\graphify.EXE hook-guard read"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/check-playbooks.mjs\" baseline",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/extract-convex-edges.mjs\"",
            "timeout": 30,
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/check-playbooks.mjs\" check",
            "timeout": 30,
            "statusMessage": "Checking playbook freshness"
          },
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/check-planning.mjs\"",
            "timeout": 30,
            "statusMessage": "Checking planning corpus"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/check-playbooks.mjs\" check",
            "timeout": 30,
            "statusMessage": "Checking playbook freshness"
          }
        ]
      }
    ]
  }
}
