node_modules/
.pnpm-store/

# Build outputs
.next/
.turbo/
dist/
out/

# Convex codegen — regenerated by `npx convex dev` / `npx convex codegen` (see README)
**/_generated/

# Local Convex deployment state (`CONVEX_DEPLOYMENT=local:…`). Holds
# `convex_local_backend.sqlite3` + `convex_local_storage/` — i.e. REAL tenant rows: vault
# documents, audit entries, PII. It was never tracked, but it was never ignored either, so a
# `git add -A` in any worktree would have committed the whole dev database. Never commit it.
**/.convex/

# Env / secrets
.env
.env.local
.env.*.local
*.local

# Next
next-env.d.ts

# TypeScript incremental build info
*.tsbuildinfo

# OS / editor
.DS_Store
*.log

# graphify repo knowledge graph — commit graph.json (so the MCP works from a clean
# clone) + the human-readable report; ignore regenerable caches and large HTML views.
graphify-out/cache/
graphify-out/*.html
graphify-out/20[0-9][0-9]-*/
.playwright-mcp/

# Parallel-lane git worktrees (multi-session build)
.worktrees/

# Raw screenshot dump (deduped into docs/design/brand/)
/Screenshots/

# 16-09: detached eval run logs + pid files (launch-detached.ps1)
packages/backend/.eval-runs/

# Backups of the local env file. `.env.local` is ignored above, but a `.bak-*` suffix escapes
# both patterns — which is how two of them ended up untracked-but-visible. Close the class, so a
# future backup of a file that DOES hold secrets cannot be committed by accident.
.env.local.bak*
.env.*.bak*

# Python bytecode from the Skills/ scripts.
__pycache__/
*.pyc

# Source ebooks under Skills/. The authored skill content (SKILL.md, the playbooks, the scripts)
# IS committed; the PDFs they were written from are not. Three reasons, in order: they are ~31 MB
# of binaries that would sit in git history permanently and irreversibly; they are commercially
# published books; and nothing in the build reads them — `growth-os-skill-suite` already records
# that the PDFs are deliberately not ingested.
Skills/**/*.pdf
Skills/*.pdf
