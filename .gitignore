node_modules/
.pnpm-store/

# Build outputs
.next/
.turbo/
dist/
out/

# Convex codegen — the application API types are committed so clean checkouts and CI can
# typecheck without credentials for a live deployment. Keep other generated directories ignored,
# including Convex's local AI guidance cache.
**/_generated/*
!packages/backend/convex/_generated/api.d.ts
!packages/backend/convex/_generated/api.js
!packages/backend/convex/_generated/dataModel.d.ts
!packages/backend/convex/_generated/server.d.ts
!packages/backend/convex/_generated/server.js

# Local Convex deployment state (`CONVEX_DEPLOYMENT=local:…`). Holds
# `convex_local_backend.sqlite3` + `convex_local_storage/` — i.e. REAL tenant rows: vault
# documents, audit entries, PII. It was never tracked, but it was never ignored either, so a
# `git add -A` in any worktree would have committed the whole dev database. Never commit it.
**/.convex/

# Env / secrets
.env
.env.local
.env.*.local
*.local

# Next
next-env.d.ts

# TypeScript incremental build info
*.tsbuildinfo

# OS / editor
.DS_Store
*.log

# graphify repo knowledge graph — commit graph.json (so the MCP works from a clean
# clone) + the human-readable report; ignore regenerable caches and large HTML views.
graphify-out/cache/
graphify-out/*.html
graphify-out/20[0-9][0-9]-*/
.playwright-mcp/

# Parallel-lane git worktrees (multi-session build)
.worktrees/

# Raw screenshot dump (deduped into docs/design/brand/)
/Screenshots/

# 16-09: detached eval run logs + pid files (launch-detached.ps1)
packages/backend/.eval-runs/

# Backups of the local env file. `.env.local` is ignored above, but a `.bak-*` suffix escapes
# both patterns — which is how two of them ended up untracked-but-visible. Close the class, so a
# future backup of a file that DOES hold secrets cannot be committed by accident.
.env.local.bak*
.env.*.bak*

# GCP service-account key files (2026-08-07). One arrived UNTRACKED in the repo ROOT holding a
# real private key for pikar-ai@…iam.gserviceaccount.com — never committed, absent from history,
# but not ignored either, so it sat one `git add -A` away from a published credential. That is a
# sharper risk here than in a normal repo: parallel lanes share ONE working tree
# (.planning/PARALLELIZATION.md), so a foreign lane's staging can sweep up a file this lane
# dropped. Same reasoning as the .bak rule above — close the CLASS by name shape, because console
# downloads are `<project-id>-<key-id>.json` and the next one will have a different name.
# Verified against `git ls-files`: these patterns match ZERO tracked files.
# Ignoring is the floor, not the fix — a key the repo does not read belongs outside the repo.
project-*-*.json
*service-account*.json
*serviceaccount*.json
gcp-*key*.json
# 2026-08-07, second key: the patterns above were keyed on the FIRST key's name shape and did not
# match `gen-lang-client-0695333543-b22eb0882301.json`, so a replacement credential landed
# unignored in the repo root. That is the same one-`git add -A`-from-published risk, re-created by
# naming alone — proof that per-filename ignores do not close this class.
# The rule that actually generalises: a GCP console key is always `<project-ish>-<12 hex>.json`.
# Verified against `git ls-files`: both patterns match ZERO tracked files.
gen-lang-client-*.json
*-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f].json

# Python bytecode from the Skills/ scripts.
__pycache__/
*.pyc

# Source ebooks under Skills/. The authored skill content (SKILL.md, the playbooks, the scripts)
# IS committed; the PDFs they were written from are not. Three reasons, in order: they are ~31 MB
# of binaries that would sit in git history permanently and irreversibly; they are commercially
# published books; and nothing in the build reads them — `growth-os-skill-suite` already records
# that the PDFs are deliberately not ingested.
Skills/**/*.pdf
Skills/*.pdf
